rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Função auxiliar para verificar se o usuário está logado
    function isAuthenticated() {
      return request.auth != null;
    }

    // Função auxiliar para obter os dados do usuário atual
    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    // Função auxiliar para verificar se é admin
    function isAdmin() {
      return isAuthenticated() && getUserData().role == 'admin';
    }

    // Função auxiliar para verificar se é secretaria ou admin
    function isSecretariaOrAdmin() {
      let role = getUserData().role;
      return isAuthenticated() && (role == 'admin' || role == 'secretaria');
    }

    // Função auxiliar para verificar se é pastor, secretaria ou admin
    function canManageMembers() {
      let role = getUserData().role;
      return isAuthenticated() && (role == 'admin' || role == 'secretaria' || role == 'pastor');
    }

    // Regras para a coleção de usuários e sessões
    match /users/{userId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
      
      // Regras para sessão do usuário
      match /session/{sessionId} {
        allow read, write: if request.auth.uid == userId;
      }
    }

    // Regras para a coleção de membros
    match /members/{memberId} {
      allow read: if isAuthenticated();
      allow create, update: if canManageMembers();
      allow delete: if isAdmin();
    }

    // Regras para Testemunhos
    match /testimonies/{testimonyId} {
      // Qualquer um pode ler testemunhos públicos e aprovados
      allow read: if (resource.data.isPublic == true && resource.data.isApproved == true) || isAuthenticated();
      // Apenas autenticados podem criar (dashboard) ou admin aprovar
      allow create: if isAuthenticated();
      allow update, delete: if canManageMembers();
    }

    // Regras para Pedidos de Oração
    match /prayer_requests/{requestId} {
      // Público pode criar (enviar pedido)
      allow create: if true;
      // Apenas admin/pastor/secretaria pode ler todos
      allow read: if canManageMembers();
      // Leitura pública apenas se aprovado e marcado como público
      allow read: if (resource.data.isPublic == true && resource.data.isApproved == true);
      allow update, delete: if canManageMembers();
    }

    // Regras para Logs de Auditoria
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated(); // Sistema cria logs
      allow update, delete: if false; // Logs são imutáveis
    }
    
    // Regras para outros módulos (Eventos, Ministérios, Células, Finanças)
    match /events/{eventId} {
      allow read: if true; // Público pode ver eventos
      allow write: if canManageMembers();
    }
    
    match /ministries/{ministryId} {
      allow read: if true;
      allow write: if canManageMembers();
    }
    
    match /cells/{cellId} {
      allow read: if true;
      allow write: if canManageMembers();
    }

    // Regras para Sermões
    match /sermons/{sermonId} {
      allow read: if true;
      allow write: if canManageMembers();
    }
    
    match /financial_transactions/{transactionId} {
      allow read, write: if isAdmin() || (isSecretariaOrAdmin() && request.auth.token.email == 'financeiro@ibn.com'); // Exemplo de restrição extra
    }
  }
}
